```{=html}
<%
  const meses = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
%>
<div class="list nov-lista">
<% for (const item of items) {
  const d = item.date ? new Date(String(item.date).slice(0, 10) + "T12:00:00Z") : null;
%>
<a class="nov-item" href="<%- item.path %>" <%= metadataAttrs(item) %>>
  <% if (d && !isNaN(d)) { %>
  <span class="nov-data"><span class="nov-dia"><%= String(d.getUTCDate()).padStart(2, "0") %></span><span class="nov-mes"><%= meses[d.getUTCMonth()] %> <%= d.getUTCFullYear() %></span></span>
  <% } %>
  <span class="nov-texto">
    <% if (item.categories && item.categories.length) { %><span class="nov-cat"><%= item.categories[0] %></span><% } %>
    <span class="nov-titulo listing-title"><%= item.title %></span>
    <% if (item.description) { %><span class="nov-desc"><%= item.description %></span><% } %>
  </span>
  <i class="bi bi-arrow-right nov-seta" aria-hidden="true"></i>
</a>
<% } %>
</div>
```
